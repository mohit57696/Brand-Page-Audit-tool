# Copy to .env.production on the server. Do not commit actual credentials.
AUDIT_REQUIRE_AUTH=true
AUDIT_ADMIN_USERNAME=
AUDIT_ADMIN_PASSWORD=
# Company gateway: set IMLLM_API_KEY; or leave it blank and set GEMINI_API_KEY.
IMLLM_API_KEY=
IMLLM_BASE_URL=https://imllm.intermesh.net/v1
IMLLM_MODEL=google/gemini-3.1-pro-preview
LLM_API_MODE=responses
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
